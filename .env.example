# Crumbs ledger — environment template (LOCAL DEV ONLY)
# Copy to .env and fill with YOUR OWN values. NEVER commit .env or real keys.
# All values here are placeholders — no real secrets exist in this repo.

# --- Database (SQLite for local; Postgres in prod via migrations/0001_init.sql)
# CRUMBS_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/crumbs
CRUMBS_DATABASE_URL=sqlite:///./crumbs_dev.db

# --- Redis (used-nonce + rate limits). Empty -> in-memory fallback (dev only)
# CRUMBS_REDIS_URL=redis://localhost:6379/0

# --- Signing keys: comma-separated kid:hex pairs. Generate with:
#   python -c "from app.signing import generate_key_hex; print(generate_key_hex())"
# kid=1 is the issuance default. Rotate by adding kid=2,3... and removing old
# kids only after max TTL + grace.
CRUMBS_SIGNING_KEYS=1:REPLACE_WITH_64_HEX_CHARS

# --- Admin (revocation endpoints). Empty disables admin endpoints.
CRUMBS_ADMIN_TOKEN=REPLACE_WITH_LONG_RANDOM_TOKEN

# --- Optional merchant key gate on /v1/conversions (empty = open)
# CRUMBS_MERCHANT_API_KEY=

# --- Payouts (records only — settlement is a STUB, env-gated)
# Default is FALSE (fail-closed). Flip explicitly to enable scheduling records.
CRUMBS_PAYOUTS_ENABLED=false

# --- Consent provider re-validation (STUB: must stay empty in v0.1)
# CRUMBS_CMP_VERIFY_URL=
