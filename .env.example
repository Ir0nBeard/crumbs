# Crumbs ledger — environment template (LOCAL DEV ONLY)
# Copy to .env and fill with YOUR OWN values. NEVER commit .env or real keys.
# All values here are placeholders — no real secrets exist in this repo.

# --- Database (SQLite for local; Postgres in prod via migrations/0001_init.sql)
# CRUMBS_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/crumbs
CRUMBS_DATABASE_URL=sqlite:///./crumbs_dev.db

# --- Redis (used-nonce + rate limits). Empty -> in-memory fallback (dev only)
# CRUMBS_REDIS_URL=redis://localhost:6379/0

# --- Signing keys: comma-separated kid:hex pairs. Generate with:
#   python -c "from app.signing import generate_key_hex; print(generate_key_hex())"
# kid=1 is the issuance default. Rotate by adding kid=2,3... and removing old
# kids only after max TTL + grace.
CRUMBS_SIGNING_KEYS=1:REPLACE_WITH_64_HEX_CHARS

# --- Admin (revocation endpoints). Empty disables admin endpoints.
CRUMBS_ADMIN_TOKEN=REPLACE_WITH_LONG_RANDOM_TOKEN

# --- Merchant auth (per-merchant keyed tokens — recommended) ---------------
# Issue tokens via POST /v1/admin/merchants/{mid}/tokens (admin token above).
# Only SHA-256 hashes are stored; the plaintext cmk_ value is shown once.
#
# Legacy shared key gate on /v1/conversions (DEPRECATED — kept for
# back-compatibility; empty = open):
# CRUMBS_MERCHANT_API_KEY=
#
# When true, /v1/conversions REQUIRES a valid per-merchant token and rejects
# the legacy shared key (fail closed):
# CRUMBS_REQUIRE_MERCHANT_TOKENS=false

# --- CORS (browser transport gate) ------------------------------------------
# Comma-separated origins allowed to call the API from a browser. EMPTY = no
# cross-origin browser access (fail closed). Per-token origin allowlists add
# authorization-level scoping on /v1/conversions.
# CRUMBS_CORS_ORIGINS=https://shop.example.com

# --- Payouts (records + settlement-proof recording only; NO float held — env-gated)
# Default is FALSE (fail-closed). Flip explicitly to enable scheduling records.
CRUMBS_PAYOUTS_ENABLED=false

# --- Webhook secrets (secretref indirection — core/secrets.py) --------------
# Merchant webhook signing secrets are stored in the database as REFERENCES,
# never as material. Production pattern:
#   1. put the secret in the service environment, e.g.:
#        CRUMBS_WEBHOOK_SECRET_M_<mid>=<long random hex>
#   2. store the reference on the merchant via the admin API:
#        POST /v1/admin/merchants/{mid}/webhook-secret
#        {"value": "secretref:env:CRUMBS_WEBHOOK_SECRET_M_<mid>"}
# Literal values remain accepted for local SQLite dev only. Flip this on in
# production to make literals fail closed on non-SQLite databases:
# CRUMBS_ENFORCE_SECRET_REFS=false

# --- Consent provider re-validation (STUB: must stay empty in v0.1)
# CRUMBS_CMP_VERIFY_URL=
